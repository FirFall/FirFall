.wrangler/
backend/users.db
node_modules/

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Android build output. Everything here is regenerated by android/build.mjs.
android/build/

# The APK signing key is deliberately not in git. Back this file up somewhere
# safe: Android only accepts an update to an installed app if it is signed
# with the same key, so losing it means every user has to uninstall first.
android/firfall-release.jks
android/firfall-release.jks.*

# The built APK and the generated icons are outputs, not source in dist/. The
# .idsig is apksigner's v4 signature sidecar and only matters for incremental
# install.
#
# public/FirFall.apk IS committed, deliberately: it is the copy the website
# serves to phones that want the app, and the site is deployed straight out of
# this working tree, so an uncommitted APK means a download link with nothing
# behind it. Rebuild with android/build.mjs, then copy it here.
dist/FirFall.apk
dist/FirFall.apk.idsig
